local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Globals = getgenv and getgenv() or _G

local SendRequest =
    request
    or http_request
    or httprequest
    or (syn and syn.request)
    or (GetDevice and GetDevice().request)

local ProgressWebhook = {}

local WebhookURL = tostring(Globals.WebhookURL or Globals.Webhook or "")
local WatcherRunning = false
local Sending = false
local LastDetectedLevel = nil
local OwnedTowers = {}
local TowersInitialized = false

local EMBED_COLOR = 7085778

local function Trim(text)
    return tostring(text or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

local function FormatNumber(value)
    local number = math.floor(tonumber(value) or 0)
    local formatted = tostring(number)

    while true do
        local updated, count =
            formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")

        formatted = updated

        if count == 0 then
            break
        end
    end

    return formatted
end

local function GetStat(name)
    local stats = shared.AutoProgressStats

    if stats and stats.GetSnapshot then
        local ok, snapshot = pcall(function()
            return stats.GetSnapshot()
        end)

        if ok
            and type(snapshot) == "table"
            and snapshot[name] ~= nil then

            return tonumber(snapshot[name]) or 0
        end
    end

    local direct = LocalPlayer:FindFirstChild(name)

    if direct and direct.Value ~= nil then
        return tonumber(direct.Value) or 0
    end

    local attribute = LocalPlayer:GetAttribute(name)

    if attribute ~= nil then
        return tonumber(attribute) or 0
    end

    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local stat = leaderstats and leaderstats:FindFirstChild(name)

    if stat and stat.Value ~= nil then
        return tonumber(stat.Value) or 0
    end

    return 0
end

local function ReadNumberObject(object)
    if not object then
        return nil
    end

    local value

    pcall(function()
        value = object.ContentText
    end)

    if value == nil or tostring(value) == "" then
        pcall(function()
            value = object.Text
        end)
    end

    if value == nil or tostring(value) == "" then
        pcall(function()
            value = object.Value
        end)
    end

    local text = tostring(value or ""):gsub(",", "")
    local number = tonumber(text:match("%d+"))

    return number
end

local function GetRewardScreenLevel()
    local rewards = PlayerGui:FindFirstChild("ReactGameNewRewards")
    local frame = rewards and rewards:FindFirstChild("Frame")
    local gameOver = frame and frame:FindFirstChild("gameOver")
    local rewardsScreen =
        gameOver
        and gameOver:FindFirstChild("RewardsScreen")

    local other =
        rewardsScreen
        and rewardsScreen:FindFirstChild("other")

    local levelFrame =
        other
        and other:FindFirstChild("level")

    local currentLevel =
        levelFrame
        and levelFrame:FindFirstChild("currentLevel")

    return ReadNumberObject(currentLevel)
end

local function GetCurrentLevel()
    local rewardLevel = GetRewardScreenLevel()

    if rewardLevel and rewardLevel > 0 then
        return rewardLevel
    end

    local level = GetStat("Level")

    if level and level > 0 then
        return level
    end

    return nil
end

local function GetOwnedTowers()
    local inventory =
        PlayerGui:FindFirstChild("ReactUniversalInventoryView")

    if not inventory then
        return nil
    end

    local holder = inventory:FindFirstChild("Holder")
    local windowFrame =
        holder and holder:FindFirstChild("windowFrame")

    local towerFrame =
        windowFrame
        and windowFrame:FindFirstChild("towersInventoryFrame")

    if not towerFrame then
        return nil
    end

    local owned = {}
    local foundAnyTowerEntry = false

    for _, object in ipairs(towerFrame:GetDescendants()) do
        if object:IsA("Frame") then
            local refLabel =
                object:FindFirstChild("refLabel", true)

            local background =
                object:FindFirstChild("background", true)

            if refLabel and background then
                local towerName = Trim(refLabel.Text)

                if towerName ~= "" then
                    foundAnyTowerEntry = true

                    if background.Visible == false then
                        owned[towerName] = true
                    end
                end
            end
        end
    end

    if not foundAnyTowerEntry then
        return nil
    end

    return owned
end

local function CountOwnedTowers(owned)
    local count = 0

    for _ in pairs(owned or {}) do
        count += 1
    end

    return count
end

local function BuildEmbed(eventType, data)
    data = type(data) == "table" and data or {}

    local level = tonumber(data.Level) or GetCurrentLevel() or 0
    local coins = tonumber(GetStat("Coins")) or 0
    local gems = tonumber(GetStat("Gems")) or 0
    local fields = {}
    local title
    local description

    if eventType == "level_up" then
        local previousLevel =
            tonumber(data.PreviousLevel)
            or math.max(level - 1, 0)

        title = "⬆️ Level Up!"
        description =
            "**"
            .. LocalPlayer.Name
            .. "** reached a new level."

        table.insert(fields, {
            name = "Level",
            value =
                FormatNumber(previousLevel)
                .. " → **"
                .. FormatNumber(level)
                .. "**",
            inline = false
        })
    elseif eventType == "tower_bought" then
        local towerName =
            Trim(data.TowerName)

        title = "🛒 Tower Purchased!"
        description =
            "**"
            .. LocalPlayer.Name
            .. "** added a new tower to their account."

        table.insert(fields, {
            name = "New Tower",
            value =
                towerName ~= ""
                and ("**" .. towerName .. "**")
                or "**Unknown Tower**",
            inline = false
        })
    else
        title = "📊 Current Progress"
        description =
            "Current progression stats for **"
            .. LocalPlayer.Name
            .. "**."
    end

    table.insert(fields, {
        name = "Level",
        value = FormatNumber(level),
        inline = true
    })

    table.insert(fields, {
        name = "Coins",
        value = "🪙 " .. FormatNumber(coins),
        inline = true
    })

    table.insert(fields, {
        name = "Gems",
        value = "💎 " .. FormatNumber(gems),
        inline = true
    })

    if data.OwnedTowerCount ~= nil then
        table.insert(fields, {
            name = "Owned Towers",
            value = FormatNumber(data.OwnedTowerCount),
            inline = true
        })
    end

    return {
        title = title,
        description = description,
        color = EMBED_COLOR,
        fields = fields,
        footer = {
            text = "Rya Auto Progression • Progress Tracker"
        },
        timestamp = DateTime.now():ToIsoDate()
    }
end

local function SendPayload(eventType, data)
    if Sending then
        return false, "Already sending"
    end

    local webhook = Trim(WebhookURL)

    if webhook == "" then
        return false, "Webhook is empty"
    end

    if not SendRequest then
        return false, "Executor does not support HTTP requests"
    end

    Sending = true

    local payload = {
        username = "Rya Progression",
        embeds = {
            BuildEmbed(eventType, data)
        }
    }

    local success, response = pcall(function()
        return SendRequest({
            Url = webhook,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    Sending = false

    if not success then
        return false, response
    end

    local statusCode =
        response
        and (
            response.StatusCode
            or response.Status
        )

    if statusCode
        and tonumber(statusCode)
        and tonumber(statusCode) >= 400 then

        return false, "HTTP " .. tostring(statusCode)
    end

    return true
end

function ProgressWebhook.SetWebhook(url)
    WebhookURL = Trim(url)
    Globals.WebhookURL = WebhookURL
    Globals.Webhook = WebhookURL

    return true
end

function ProgressWebhook.GetWebhook()
    return WebhookURL
end

function ProgressWebhook.Send(eventType, data)
    if eventType == "level_up"
        or eventType == "tower_bought" then

        return SendPayload(eventType, data)
    end

    if eventType == true
        or eventType == "manual"
        or eventType == "stats"
        or eventType == nil then

        local owned =
            GetOwnedTowers()
            or OwnedTowers

        return SendPayload("manual", {
            Level = GetCurrentLevel(),
            OwnedTowerCount = CountOwnedTowers(owned)
        })
    end

    return false, "Unknown webhook event"
end

function ProgressWebhook.GetLevel()
    return GetCurrentLevel()
end

function ProgressWebhook.Start()
    if WatcherRunning then
        return true
    end

    WatcherRunning = true

    task.spawn(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end

        task.wait(2)

        while WatcherRunning do
            local currentLevel = GetCurrentLevel()

            if currentLevel and currentLevel > 0 then
                if LastDetectedLevel == nil then
                    LastDetectedLevel = currentLevel
                elseif currentLevel > LastDetectedLevel then
                    local previousLevel = LastDetectedLevel

                    LastDetectedLevel = currentLevel

                    SendPayload("level_up", {
                        PreviousLevel = previousLevel,
                        Level = currentLevel,
                        OwnedTowerCount =
                            CountOwnedTowers(
                                GetOwnedTowers()
                                or OwnedTowers
                            )
                    })
                elseif currentLevel < LastDetectedLevel then
                    LastDetectedLevel = currentLevel
                end
            end

            local currentOwned = GetOwnedTowers()

            if currentOwned then
                if not TowersInitialized then
                    OwnedTowers = currentOwned
                    TowersInitialized = true
                else
                    for towerName in pairs(currentOwned) do
                        if OwnedTowers[towerName] ~= true then
                            OwnedTowers[towerName] = true

                            SendPayload("tower_bought", {
                                TowerName = towerName,
                                Level = currentLevel,
                                OwnedTowerCount =
                                    CountOwnedTowers(currentOwned)
                            })
                        end
                    end

                    for towerName in pairs(OwnedTowers) do
                        if currentOwned[towerName] ~= true then
                            OwnedTowers[towerName] = nil
                        end
                    end
                end
            end

            task.wait(1)
        end
    end)

    return true
end

function ProgressWebhook.Stop()
    WatcherRunning = false
    return true
end

function ProgressWebhook.GetLastLevel()
    return LastDetectedLevel
end

shared.ProgressWebhook = ProgressWebhook

return ProgressWebhook
