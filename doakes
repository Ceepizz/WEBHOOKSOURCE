local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Globals = getgenv and getgenv() or _G
local LOBBY_PLACE_ID = 3260590327

local SendRequest =
    request
    or http_request
    or httprequest
    or (syn and syn.request)
    or (GetDevice and GetDevice().request)

local ProgressWebhook = {}

local WebhookURL = tostring(Globals.WebhookURL or Globals.Webhook or "")
local WatcherRunning = false
local Sending = false
local LastDetectedLevel = nil
local OwnedTowers = {}
local TowersInitialized = false

local EMBED_COLOR = 7085778

local function Trim(text)
    return tostring(text or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

local function FormatNumber(value)
    local number = math.floor(tonumber(value) or 0)
    local formatted = tostring(number)

    while true do
        local updated, count =
            formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")

        formatted = updated

        if count == 0 then
            break
        end
    end

    return formatted
end

local function GetProgressSnapshot()
    local snapshot = {}

    local stats = shared.AutoProgressStats

    if stats and stats.GetSnapshot then
        local ok, result = pcall(function()
            return stats.GetSnapshot()
        end)

        if ok and type(result) == "table" then
            for key, value in pairs(result) do
                snapshot[key] = value
            end
        end
    end

    local function ReadDirectLevel()
        local direct = LocalPlayer:FindFirstChild("Level")

        if direct and direct.Value ~= nil then
            return tonumber(direct.Value)
        end

        local attribute = LocalPlayer:GetAttribute("Level")

        if attribute ~= nil then
            return tonumber(attribute)
        end

        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        local stat = leaderstats and leaderstats:FindFirstChild("Level")

        if stat and stat.Value ~= nil then
            return tonumber(stat.Value)
        end

        return nil
    end

    if snapshot.Level == nil then
        snapshot.Level = ReadDirectLevel()
    end

    if game.PlaceId == LOBBY_PLACE_ID
        and Globals.__RyaGetLobbyCurrencyBalance then

        local okCoins, lobbyCoins = pcall(function()
            return Globals.__RyaGetLobbyCurrencyBalance("Coins")
        end)

        if okCoins and tonumber(lobbyCoins) ~= nil then
            snapshot.Coins = tonumber(lobbyCoins)
        end

        local okGems, lobbyGems = pcall(function()
            return Globals.__RyaGetLobbyCurrencyBalance("Gems")
        end)

        if okGems and tonumber(lobbyGems) ~= nil then
            snapshot.Gems = tonumber(lobbyGems)
        end
    end

    local autoProgress = shared.AutoProgress

    if autoProgress
        and autoProgress.GetAutoMaxStats then

        local ok, autoMaxStats = pcall(function()
            return autoProgress.GetAutoMaxStats()
        end)

        if ok and type(autoMaxStats) == "table" then
            local skillPercent =
                tonumber(autoMaxStats.SkillPercent)

            if skillPercent ~= nil then
                skillPercent =
                    math.clamp(
                        math.floor(skillPercent + 0.5),
                        0,
                        100
                    )

                snapshot.SkillPercent = skillPercent
                Globals.__RyaLastSkillTreePercent = skillPercent
            end
        end
    end

    if snapshot.SkillPercent == nil then
        local cached =
            tonumber(Globals.__RyaLastSkillTreePercent)

        if cached ~= nil then
            snapshot.SkillPercent =
                math.clamp(
                    math.floor(cached + 0.5),
                    0,
                    100
                )
        end
    end

    if snapshot.Coins == nil
        and stats
        and stats.GetCoins then

        local ok, value = pcall(function()
            return stats.GetCoins()
        end)

        if ok and tonumber(value) ~= nil then
            snapshot.Coins = tonumber(value)
        end
    end

    if snapshot.Gems == nil
        and stats
        and stats.GetGems then

        local ok, value = pcall(function()
            return stats.GetGems()
        end)

        if ok and tonumber(value) ~= nil then
            snapshot.Gems = tonumber(value)
        end
    end

    snapshot.Level = tonumber(snapshot.Level) or 0
    snapshot.Coins = tonumber(snapshot.Coins) or 0
    snapshot.Gems = tonumber(snapshot.Gems) or 0

    return snapshot
end

local function GetStat(name)
    local stats = shared.AutoProgressStats

    if stats and stats.GetSnapshot then
        local ok, snapshot = pcall(function()
            return stats.GetSnapshot()
        end)

        if ok
            and type(snapshot) == "table"
            and snapshot[name] ~= nil then

            return tonumber(snapshot[name]) or 0
        end
    end

    if name == "Coins"
        or name == "Gems" then

        local snapshot = GetProgressSnapshot()
        return tonumber(snapshot[name]) or 0
    end

    local direct = LocalPlayer:FindFirstChild(name)

    if direct and direct.Value ~= nil then
        return tonumber(direct.Value) or 0
    end

    local attribute = LocalPlayer:GetAttribute(name)

    if attribute ~= nil then
        return tonumber(attribute) or 0
    end

    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local stat = leaderstats and leaderstats:FindFirstChild(name)

    if stat and stat.Value ~= nil then
        return tonumber(stat.Value) or 0
    end

    return 0
end

local function ReadNumberObject(object)
    if not object then
        return nil
    end

    local value

    pcall(function()
        value = object.ContentText
    end)

    if value == nil or tostring(value) == "" then
        pcall(function()
            value = object.Text
        end)
    end

    if value == nil or tostring(value) == "" then
        pcall(function()
            value = object.Value
        end)
    end

    local text = tostring(value or ""):gsub(",", "")
    local number = tonumber(text:match("%d+"))

    return number
end

local function GetRewardScreenLevel()
    local rewards = PlayerGui:FindFirstChild("ReactGameNewRewards")
    local frame = rewards and rewards:FindFirstChild("Frame")
    local gameOver = frame and frame:FindFirstChild("gameOver")
    local rewardsScreen =
        gameOver
        and gameOver:FindFirstChild("RewardsScreen")

    local other =
        rewardsScreen
        and rewardsScreen:FindFirstChild("other")

    local levelFrame =
        other
        and other:FindFirstChild("level")

    local currentLevel =
        levelFrame
        and levelFrame:FindFirstChild("currentLevel")

    return ReadNumberObject(currentLevel)
end

local function GetCurrentLevel()
    local rewardLevel = GetRewardScreenLevel()

    if rewardLevel and rewardLevel > 0 then
        return rewardLevel
    end

    local level = GetStat("Level")

    if level and level > 0 then
        return level
    end

    return nil
end

local function GetOwnedTowers()
    local inventory =
        PlayerGui:FindFirstChild("ReactUniversalInventoryView")

    if not inventory then
        return nil
    end

    local holder = inventory:FindFirstChild("Holder")
    local windowFrame =
        holder and holder:FindFirstChild("windowFrame")

    local towerFrame =
        windowFrame
        and windowFrame:FindFirstChild("towersInventoryFrame")

    if not towerFrame then
        return nil
    end

    local owned = {}
    local foundAnyTowerEntry = false

    for _, object in ipairs(towerFrame:GetDescendants()) do
        if object:IsA("Frame") then
            local refLabel =
                object:FindFirstChild("refLabel", true)

            local background =
                object:FindFirstChild("background", true)

            if refLabel and background then
                local towerName = Trim(refLabel.Text)

                if towerName ~= "" then
                    foundAnyTowerEntry = true

                    if background.Visible == false then
                        owned[towerName] = true
                    end
                end
            end
        end
    end

    if not foundAnyTowerEntry then
        return nil
    end

    return owned
end

local function CountOwnedTowers(owned)
    local count = 0

    for _ in pairs(owned or {}) do
        count += 1
    end

    return count
end

local function GetGoldenSkinsOwned()
    local stores =
        filtergc("table", {
            Keys = {"getState"}
        }) or {}

    local goldenOwned = {}

    for _, store in ipairs(stores) do
        local success, stateData =
            pcall(store.getState, store)

        if success and type(stateData) == "table" then
            local skins =
                stateData.skins
                or stateData.Skins
                or stateData.towerSkins
                or stateData.TowerSkins

            if type(skins) == "table" then
                for towerName, ownedSkins in pairs(skins) do
                    if type(ownedSkins) == "table" then
                        for _, skinName in pairs(ownedSkins) do
                            if skinName == "Golden" then
                                goldenOwned[tostring(towerName)] = true
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    local towers = {}

    for towerName in pairs(goldenOwned) do
        table.insert(towers, towerName)
    end

    table.sort(towers)

    return towers
end

local function GetSkillTreePercent()
    local totalCurrent = 0
    local totalMax = 0
    local found = 0

    for nodeId = 1, 17 do
        local node = workspace:FindFirstChild(tostring(nodeId))
        local gui = node and node:FindFirstChild("TileSurfaceGui")
        local frame = gui and gui:FindFirstChild("Frame")
        local skillLevel = frame and frame:FindFirstChild("SkillLevel")

        if skillLevel then
            local text = tostring(skillLevel.Text or "")

            local current, maximum =
                text:match("(%d+)%s*/%s*(%d+)")

            current = tonumber(current)
            maximum = tonumber(maximum)

            if not current or not maximum then
                local maxOnly =
                    tonumber(
                        text:match("MAX%s*%[(%d+)%]")
                    )

                if maxOnly then
                    current = maxOnly
                    maximum = maxOnly
                end
            end

            if current and maximum and maximum > 0 then
                found += 1
                totalCurrent += math.min(current, maximum)
                totalMax += maximum
            end
        end
    end

    if found == 17 and totalMax > 0 then
        local percent =
            math.floor(
                (totalCurrent / totalMax) * 100
                + 0.5
            )

        percent = math.clamp(percent, 0, 100)
        Globals.__RyaLastSkillTreePercent = percent
        return percent
    end

    local autoProgress = shared.AutoProgress

    if autoProgress
        and autoProgress.GetAutoMaxStats then

        local ok, stats = pcall(function()
            return autoProgress.GetAutoMaxStats()
        end)

        if ok and type(stats) == "table" then
            local percent = tonumber(stats.SkillPercent)

            if percent ~= nil then
                percent =
                    math.clamp(
                        math.floor(percent + 0.5),
                        0,
                        100
                    )

                Globals.__RyaLastSkillTreePercent = percent
                return percent
            end
        end
    end

    local cached =
        tonumber(Globals.__RyaLastSkillTreePercent)

    if cached ~= nil then
        return math.clamp(
            math.floor(cached + 0.5),
            0,
            100
        )
    end

    return nil
end

local function BuildEmbed(eventType, data)
    data = type(data) == "table" and data or {}

    local snapshot = GetProgressSnapshot()

    local level =
        tonumber(data.Level)
        or tonumber(snapshot.Level)
        or GetCurrentLevel()
        or 0

    local coins = tonumber(data.Coins) or tonumber(snapshot.Coins) or 0
    local gems = tonumber(data.Gems) or tonumber(snapshot.Gems) or 0
    local fields = {}
    local title
    local description

    if eventType == "level_up" then
        title = "Level Up!"
        description =
            "**"
            .. LocalPlayer.Name
            .. "** reached a new level."

    elseif eventType == "tower_bought" then
        local towerName =
            Trim(data.TowerName)

        title = "Tower Purchased!"
        description =
            "**"
            .. LocalPlayer.Name
            .. "** added a new tower to their account."

        table.insert(fields, {
            name = "New Tower",
            value =
                towerName ~= ""
                and ("**" .. towerName .. "**")
                or "**Unknown Tower**",
            inline = false
        })
    else
        title = "Current Progress"
        description =
            "Current progression stats for **"
            .. LocalPlayer.Name
            .. "**."
    end

    table.insert(fields, {
        name = "Level",
        value = FormatNumber(level),
        inline = true
    })

    table.insert(fields, {
        name = "Coins",
        value = FormatNumber(coins),
        inline = true
    })

    table.insert(fields, {
        name = "Gems",
        value = FormatNumber(gems),
        inline = true
    })

    if data.OwnedTowerCount ~= nil then
        table.insert(fields, {
            name = "Owned Towers",
            value = FormatNumber(data.OwnedTowerCount),
            inline = true
        })
    end

    local goldenSkins = GetGoldenSkinsOwned()

    table.insert(fields, {
        name = "Golden Skins Owned",
        value =
            #goldenSkins > 0
            and table.concat(goldenSkins, ", ")
            or "None",
        inline = false
    })

    local skillPercent =
        tonumber(data.SkillPercent)
        or GetSkillTreePercent()
        or tonumber(snapshot.SkillPercent)

    table.insert(fields, {
        name = "Skill Tree",
        value =
            skillPercent ~= nil
            and (
                tostring(
                    math.clamp(
                        math.floor(skillPercent + 0.5),
                        0,
                        100
                    )
                )
                .. "%"
            )
            or "Unavailable",
        inline = true
    })

    return {
        title = title,
        description = description,
        color = EMBED_COLOR,
        fields = fields,
        footer = {
            text = "Rya Auto Progression  Progress Tracker"
        },
        timestamp = DateTime.now():ToIsoDate()
    }
end

local function SendPayload(eventType, data)
    if Sending then
        return false, "Already sending"
    end

    local webhook = Trim(WebhookURL)

    if webhook == "" then
        return false, "Webhook is empty"
    end

    if not SendRequest then
        return false, "Executor does not support HTTP requests"
    end

    Sending = true

    local payload = {
        username = "Rya Progression",
        embeds = {
            BuildEmbed(eventType, data)
        }
    }

    local success, response = pcall(function()
        return SendRequest({
            Url = webhook,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    Sending = false

    if not success then
        return false, response
    end

    local statusCode =
        response
        and (
            response.StatusCode
            or response.Status
        )

    if statusCode
        and tonumber(statusCode)
        and tonumber(statusCode) >= 400 then

        return false, "HTTP " .. tostring(statusCode)
    end

    return true
end

function ProgressWebhook.SetWebhook(url)
    WebhookURL = Trim(url)
    Globals.WebhookURL = WebhookURL
    Globals.Webhook = WebhookURL

    return true
end

function ProgressWebhook.GetWebhook()
    return WebhookURL
end

function ProgressWebhook.Send(eventType, data)
    if eventType == "level_up"
        or eventType == "tower_bought" then

        return SendPayload(eventType, data)
    end

    if eventType == true
        or eventType == "manual"
        or eventType == "stats"
        or eventType == nil then

        local owned =
            GetOwnedTowers()
            or OwnedTowers

        local snapshot = GetProgressSnapshot()

        return SendPayload("manual", {
            Level = snapshot.Level,
            Coins = snapshot.Coins,
            Gems = snapshot.Gems,
            OwnedTowerCount = CountOwnedTowers(owned)
        })
    end

    return false, "Unknown webhook event"
end

function ProgressWebhook.GetLevel()
    return GetCurrentLevel()
end

function ProgressWebhook.Start()
    if WatcherRunning then
        return true
    end

    WatcherRunning = true

    task.spawn(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end

        task.wait(2)

        while WatcherRunning do
            local currentLevel = GetCurrentLevel()

            if currentLevel and currentLevel > 0 then
                if LastDetectedLevel == nil then
                    LastDetectedLevel = currentLevel
                elseif currentLevel > LastDetectedLevel then
                    local previousLevel = LastDetectedLevel

                    LastDetectedLevel = currentLevel

                    SendPayload("level_up", {
                        PreviousLevel = previousLevel,
                        Level = currentLevel,
                        OwnedTowerCount =
                            CountOwnedTowers(
                                GetOwnedTowers()
                                or OwnedTowers
                            )
                    })
                elseif currentLevel < LastDetectedLevel then
                    LastDetectedLevel = currentLevel
                end
            end

            local currentOwned = GetOwnedTowers()

            if currentOwned then
                if not TowersInitialized then
                    OwnedTowers = currentOwned
                    TowersInitialized = true
                else
                    for towerName in pairs(currentOwned) do
                        if OwnedTowers[towerName] ~= true then
                            OwnedTowers[towerName] = true

                            SendPayload("tower_bought", {
                                TowerName = towerName,
                                Level = currentLevel,
                                OwnedTowerCount =
                                    CountOwnedTowers(currentOwned)
                            })
                        end
                    end

                    for towerName in pairs(OwnedTowers) do
                        if currentOwned[towerName] ~= true then
                            OwnedTowers[towerName] = nil
                        end
                    end
                end
            end

            task.wait(1)
        end
    end)

    return true
end

function ProgressWebhook.Stop()
    WatcherRunning = false
    return true
end

function ProgressWebhook.GetLastLevel()
    return LastDetectedLevel
end

shared.ProgressWebhook = ProgressWebhook

return ProgressWebhook
