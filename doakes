local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Globals = getgenv and getgenv() or _G

local GATLING_PRICE = 35000
local GATLING_TOWER = "Gatling Gun"
local LEVEL_GOAL = 175

local SendRequest =
    request
    or http_request
    or httprequest
    or (syn and syn.request)
    or (GetDevice and GetDevice().request)

local ProgressWebhook = {}

local WebhookURL = tostring(Globals.WebhookURL or "")
local LastDetectedLevel = nil
local WatcherRunning = false
local Sending = false

local function Trim(text)
    return tostring(text or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

local function FormatNumber(number)
    number = math.floor(tonumber(number) or 0)

    local formatted = tostring(number)

    while true do
        local changed

        formatted, changed = formatted:gsub(
            "^(-?%d+)(%d%d%d)",
            "%1,%2"
        )

        if changed == 0 then
            break
        end
    end

    return formatted
end

local function GetPercent(current, maximum)
    current = tonumber(current) or 0
    maximum = tonumber(maximum) or 1

    if maximum <= 0 then
        return 0
    end

    return math.clamp(
        math.floor((current / maximum) * 100),
        0,
        100
    )
end

local function ProgressBar(percent)
    percent = math.clamp(
        tonumber(percent) or 0,
        0,
        100
    )

    local totalBlocks = 20
    local filled = math.floor(
        (percent / 100) * totalBlocks
    )

    return string.rep("█", filled)
        .. string.rep("░", totalBlocks - filled)
end

local function GetStat(name)
    local direct = LocalPlayer:FindFirstChild(name)

    if direct and direct.Value ~= nil then
        return tonumber(direct.Value) or 0
    end

    local attribute = LocalPlayer:GetAttribute(name)

    if attribute ~= nil then
        return tonumber(attribute) or 0
    end

    local leaderstats =
        LocalPlayer:FindFirstChild("leaderstats")

    local stat =
        leaderstats
        and leaderstats:FindFirstChild(name)

    if stat and stat.Value ~= nil then
        return tonumber(stat.Value) or 0
    end

    return nil
end

local function ReadNumberObject(object)
    if not object then
        return nil
    end

    local value

    pcall(function()
        value = object.ContentText
    end)

    if value == nil or tostring(value) == "" then
        pcall(function()
            value = object.Text
        end)
    end

    if value == nil or tostring(value) == "" then
        pcall(function()
            value = object.Value
        end)
    end

    local text = tostring(value or "")

    text = text:gsub(",", "")

    local number =
        tonumber(text:match("%d+"))

    return number
end

local function GetRewardScreenLevel()
    local rewards =
        PlayerGui:FindFirstChild(
            "ReactGameNewRewards"
        )

    local frame =
        rewards
        and rewards:FindFirstChild("Frame")

    local gameOver =
        frame
        and frame:FindFirstChild("gameOver")

    local rewardsScreen =
        gameOver
        and gameOver:FindFirstChild(
            "RewardsScreen"
        )

    local other =
        rewardsScreen
        and rewardsScreen:FindFirstChild(
            "other"
        )

    local levelFrame =
        other
        and other:FindFirstChild("level")

    local currentLevel =
        levelFrame
        and levelFrame:FindFirstChild(
            "currentLevel"
        )

    return ReadNumberObject(currentLevel)
end

local function GetGuiLevel()
    local roots = {
        PlayerGui:FindFirstChild("ReactLobbyHud"),
        PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        ),
        PlayerGui:FindFirstChild(
            "ReactGameNewRewards"
        )
    }

    for _, root in ipairs(roots) do
        if root then
            for _, object in ipairs(
                root:GetDescendants()
            ) do
                local lowerName =
                    object.Name:lower()

                if lowerName == "currentlevel"
                    or lowerName == "playerlevel" then

                    local number =
                        ReadNumberObject(object)

                    if number
                        and number > 0
                        and number <= 1000 then

                        return number
                    end
                end
            end
        end
    end

    return nil
end

local function GetCurrentLevel()
    local rewardLevel =
        GetRewardScreenLevel()

    if rewardLevel
        and rewardLevel > 0 then

        return rewardLevel
    end

    local statLevel =
        GetStat("Level")

    if statLevel
        and statLevel > 0 then

        return statLevel
    end

    local guiLevel =
        GetGuiLevel()

    if guiLevel
        and guiLevel > 0 then

        return guiLevel
    end

    return nil
end

local function IsGatlingOwned()
    local inventory =
        PlayerGui:FindFirstChild(
            "ReactUniversalInventoryView"
        )

    if not inventory then
        return false
    end

    for _, object in ipairs(
        inventory:GetDescendants()
    ) do
        if object:IsA("Frame") then
            local refLabel =
                object:FindFirstChild(
                    "refLabel",
                    true
                )

            local background =
                object:FindFirstChild(
                    "background",
                    true
                )

            if refLabel
                and background
                and refLabel.Text == GATLING_TOWER
                and background.Visible == false then

                return true
            end
        end
    end

    return false
end

local function BuildEmbed(level)
    level =
        tonumber(level)
        or GetCurrentLevel()
        or 0

    local coins =
        tonumber(GetStat("Coins"))
        or 0

    local gatlingOwned =
        IsGatlingOwned()

    local levelPercent =
        GetPercent(
            level,
            LEVEL_GOAL
        )

    local coinPercent =
        GetPercent(
            coins,
            GATLING_PRICE
        )

    local levelProgress

    if level >= LEVEL_GOAL then
        levelProgress =
            FormatNumber(level)
            .. " / "
            .. FormatNumber(LEVEL_GOAL)
            .. "\n"
            .. ProgressBar(100)
            .. " 100%"
    else
        levelProgress =
            FormatNumber(level)
            .. " / "
            .. FormatNumber(LEVEL_GOAL)
            .. "\n"
            .. ProgressBar(levelPercent)
            .. " "
            .. tostring(levelPercent)
            .. "%"
    end

    local gatlingProgress

    if gatlingOwned then
        gatlingProgress =
            "Gatling Gun Unlocked"
    else
        gatlingProgress =
            FormatNumber(coins)
            .. " / "
            .. FormatNumber(GATLING_PRICE)
            .. " Coins\n"
            .. ProgressBar(coinPercent)
            .. " "
            .. tostring(coinPercent)
            .. "%"
    end

    local goal

    if gatlingOwned then
        goal = "Completed"
    elseif level < LEVEL_GOAL then
        goal =
            "Reach Level "
            .. tostring(LEVEL_GOAL)
            .. " and unlock Gatling Gun"
    else
        goal =
            "Unlock Gatling Gun"
    end

    return {
        title = "Auto Progress",

        description =
            "Current progress for **"
            .. LocalPlayer.Name
            .. "**",

        color = 7085778,

        fields = {
            {
                name = "Level Progress",
                value = levelProgress,
                inline = false
            },
            {
                name = "Gatling Progress",
                value = gatlingProgress,
                inline = false
            },
            {
                name = "Current Goal",
                value = goal,
                inline = false
            }
        },

        footer = {
            text =
                "Level Up Detected | Aether Hub"
        },

        timestamp =
            DateTime.now():ToIsoDate()
    }
end

function ProgressWebhook.SetWebhook(url)
    WebhookURL =
        Trim(url)

    Globals.WebhookURL =
        WebhookURL

    return true
end

function ProgressWebhook.GetWebhook()
    return WebhookURL
end

function ProgressWebhook.Send(level)
    if Sending then
        return false, "Already sending"
    end

    local webhook =
        Trim(WebhookURL)

    if webhook == "" then
        return false, "Webhook is empty"
    end

    if not SendRequest then
        return false,
            "Executor does not support HTTP requests"
    end

    Sending = true

    local payload = {
        username = "Aether Hub",

        embeds = {
            BuildEmbed(level)
        }
    }

    local encoded =
        HttpService:JSONEncode(
            payload
        )

    local success, response =
        pcall(function()
            return SendRequest({
                Url = webhook,
                Method = "POST",

                Headers = {
                    ["Content-Type"] =
                        "application/json"
                },

                Body = encoded
            })
        end)

    Sending = false

    if not success then
        warn(
            "[PROGRESS WEBHOOK] Request failed:",
            response
        )

        return false, response
    end

    local statusCode =
        response
        and (
            response.StatusCode
            or response.Status
        )

    if statusCode
        and tonumber(statusCode)
        and tonumber(statusCode) >= 400 then

        warn(
            "[PROGRESS WEBHOOK] HTTP error:",
            statusCode
        )

        return false,
            "HTTP " .. tostring(statusCode)
    end

    print(
        "[PROGRESS WEBHOOK] Sent for level:",
        level
    )

    return true
end

function ProgressWebhook.GetLevel()
    return GetCurrentLevel()
end

function ProgressWebhook.Start()
    if WatcherRunning then
        return true
    end

    WatcherRunning = true

    task.spawn(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end

        task.wait(2)

        while WatcherRunning do
            local currentLevel =
                GetCurrentLevel()

            if currentLevel
                and currentLevel > 0 then

                if LastDetectedLevel == nil then
                    LastDetectedLevel =
                        currentLevel

                    print(
                        "[PROGRESS WEBHOOK] Starting level:",
                        LastDetectedLevel
                    )

                elseif currentLevel
                    > LastDetectedLevel then

                    local previousLevel =
                        LastDetectedLevel

                    LastDetectedLevel =
                        currentLevel

                    print(
                        "[PROGRESS WEBHOOK] Level up:",
                        previousLevel,
                        "->",
                        currentLevel
                    )

                    ProgressWebhook.Send(
                        currentLevel
                    )

                elseif currentLevel
                    < LastDetectedLevel then

                    LastDetectedLevel =
                        currentLevel
                end
            end

            task.wait(1)
        end
    end)

    return true
end

function ProgressWebhook.Stop()
    WatcherRunning = false
    return true
end

function ProgressWebhook.GetLastLevel()
    return LastDetectedLevel
end

shared.ProgressWebhook =
    ProgressWebhook

ProgressWebhook.Start()

return ProgressWebhook
